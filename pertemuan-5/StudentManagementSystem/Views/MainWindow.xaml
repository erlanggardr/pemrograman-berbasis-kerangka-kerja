<Window x:Class="StudentManagementSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StudentManagementSystem.ViewModels"
        Title="Student Management System (SMS) - PBKK Pertemuan 5" 
        Height="780" Width="1240"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="#0F172A">
            <Grid Margin="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                            <TextBlock Text="🎓" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="SIMA ITS" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Student Dashboard" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Background="#1E293B" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Menu Items -->
                <StackPanel Grid.Row="1">
                    <Border Background="#1E293B" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                        <TextBlock Text="📊  Dashboard Utama" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    </Border>
                    <Border Background="Transparent" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                        <TextBlock Text="👥  Data Mahasiswa" Foreground="#94A3B8" FontSize="13"/>
                    </Border>
                    <Border Background="Transparent" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                        <TextBlock Text="📈  Statistik &amp; Laporan" Foreground="#94A3B8" FontSize="13"/>
                    </Border>
                    <Border Background="Transparent" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                        <TextBlock Text="🏛️  Program Studi" Foreground="#94A3B8" FontSize="13"/>
                    </Border>
                </StackPanel>

                <!-- Footer Sidebar -->
                <StackPanel Grid.Row="2">
                    <Separator Background="#1E293B" Margin="0,0,0,12"/>
                    <TextBlock Text="MVVM Architecture" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="PBKK Pertemuan 5 — .NET 10" FontSize="10" Foreground="#475569" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Top Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Student Management System (SMS)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Pengelolaan Data Akademik Mahasiswa berbasis Arsitektur MVVM &amp; Data Binding" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="➕ Mahasiswa Baru" Command="{Binding NewCommand}"
                                Height="34" Padding="14,0" Background="#2563EB" Foreground="White"
                                FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4 Metric KPI Cards -->
            <Grid Grid.Row="1" Margin="24,16,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Total Mahasiswa -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="TOTAL MAHASISWA" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalStudents}" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,4,0,0"/>
                            <TextBlock Text="Terdaftar di database" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="👥" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Card 2: Rata-Rata IPK -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="RATA-RATA IPK" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding AverageIPK}" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                            <TextBlock Text="Skala nilai 4.00" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="⭐" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Card 3: Mahasiswa Aktif -->
                <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="MAHASISWA AKTIF" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding ActiveStudents}" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                            <TextBlock Text="Status perkuliahan aktif" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="🟢" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Card 4: Cumlaude -->
                <Border Grid.Column="6" Background="White" CornerRadius="8" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="PREDIKAT CUMLAUDE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding CumlaudeStudents}" FontSize="24" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                            <TextBlock Text="IPK ≥ 3.51 (Dengan Pujian)" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="🏆" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Main Content Area: Data Table & Form Card -->
            <Grid Grid.Row="2" Margin="24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Left Section: Search, Filters, DataGrid -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" Padding="8,4" FontSize="12" VerticalContentAlignment="Center"
                                     ToolTip="Cari berdasarkan NRP, Nama, atau Email"/>

                            <ComboBox Grid.Column="2" ItemsSource="{Binding FilterProdiList}"
                                      SelectedItem="{Binding SelectedFilterProdi}" Height="32" FontSize="12"
                                      VerticalContentAlignment="Center"/>

                            <ComboBox Grid.Column="4" ItemsSource="{Binding FilterStatusList}"
                                      SelectedItem="{Binding SelectedFilterStatus}" Height="32" FontSize="12"
                                      VerticalContentAlignment="Center"/>

                            <Button Grid.Column="6" Content="Reset" Command="{Binding ResetFilterCommand}"
                                    Height="32" Padding="12,0" Background="#F1F5F9" Foreground="#475569"
                                    BorderBrush="#CBD5E1" BorderThickness="1" FontSize="12" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid Mahasiswa -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding Students}"
                                  SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  RowHeight="36"
                                  FontSize="12"
                                  BorderThickness="0"
                                  Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NRP" Binding="{Binding NRP}" Width="100" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding Nama}" Width="160"/>
                                <DataGridTextColumn Header="Program Studi" Binding="{Binding Prodi}" Width="140"/>
                                <DataGridTextColumn Header="Angkatan" Binding="{Binding Angkatan}" Width="65"/>
                                <DataGridTextColumn Header="IPK" Binding="{Binding IPKFormat}" Width="55" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Predikat" Binding="{Binding Predikat}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Action Bar for Selected Row -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Aksi Baris Terpilih:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                                <Button Content="✏️ Edit Data" Command="{Binding EditCommand}"
                                        Height="28" Padding="10,0" Margin="0,0,8,0" Background="#EFF6FF"
                                        Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1"
                                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                                <Button Content="🗑️ Hapus" Command="{Binding DeleteCommand}"
                                        Height="28" Padding="10,0" Background="#FEF2F2"
                                        Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"
                                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Klik baris pada tabel untuk memilih data" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right Section: MVVM Form Input Card -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding FormHeaderTitle}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                            <!-- NRP -->
                            <TextBlock Text="NRP *" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Text="{Binding FormNRP, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsNRPReadOnly}" Height="30" Margin="0,3,0,10"
                                     Padding="6,4" FontSize="12" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                            <!-- Nama -->
                            <TextBlock Text="Nama Lengkap *" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Text="{Binding FormNama, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Margin="0,3,0,10" Padding="6,4" FontSize="12"
                                     BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                            <!-- Prodi -->
                            <TextBlock Text="Program Studi *" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            <ComboBox ItemsSource="{Binding ProdiList}" SelectedItem="{Binding FormProdi}"
                                      Height="30" Margin="0,3,0,10" FontSize="12" VerticalContentAlignment="Center"/>

                            <!-- Angkatan & IPK in 2 columns -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Angkatan *" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                    <ComboBox ItemsSource="{Binding AngkatanList}" SelectedItem="{Binding FormAngkatan}"
                                              Height="30" Margin="0,3,0,0" FontSize="12" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="IPK (0-4) *" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                    <TextBox Text="{Binding FormIPK, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30" Margin="0,3,0,0" Padding="6,4" FontSize="12"
                                             BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Status Akademik -->
                            <TextBlock Text="Status Akademik *" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            <ComboBox ItemsSource="{Binding StatusList}" SelectedItem="{Binding FormStatus}"
                                      Height="30" Margin="0,3,0,10" FontSize="12" VerticalContentAlignment="Center"/>

                            <!-- Email -->
                            <TextBlock Text="Email Kampus *" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Margin="0,3,0,10" Padding="6,4" FontSize="12"
                                     BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                            <!-- Telepon -->
                            <TextBlock Text="Nomor Telepon / WA" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Text="{Binding FormTelepon, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Margin="0,3,0,16" Padding="6,4" FontSize="12"
                                     BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                            <!-- Action Buttons -->
                            <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}"
                                    Height="36" Background="#2563EB" Foreground="White" FontWeight="Bold"
                                    FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,0,6"/>

                            <Button Content="🔄 Kosongkan / Batal" Command="{Binding NewCommand}"
                                    Height="32" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold"
                                    FontSize="12" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#475569"/>
                    <TextBlock Grid.Column="1" Text="MVVM WPF .NET 10" FontSize="12" Foreground="#94A3B8"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
