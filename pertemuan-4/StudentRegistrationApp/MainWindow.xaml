<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration App - PBKK Pertemuan 4" 
        Height="720" Width="1120"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#1E3A8A" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="🎓 STUDENT REGISTRATION APPLICATION" 
                               FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Praktikum Pemrograman Berbasis Kerangka Kerja — Latihan 3 (WPF &amp; XAML .NET 10)" 
                               FontSize="12" Foreground="#93C5FD" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#2563EB" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="lblBadgeCount" Text="Total Mahasiswa: 0" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Registration Form -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#CBD5E1" Opacity="0.3"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Formulir Pendaftaran" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                        <!-- NRP -->
                        <TextBlock Text="Nomor Registrasi Pokok (NRP) *" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="txtNRP" Height="34" Margin="0,4,0,12" Padding="8,6" FontSize="13" 
                                 BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                        <!-- Nama Lengkap -->
                        <TextBlock Text="Nama Lengkap *" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="txtNama" Height="34" Margin="0,4,0,12" Padding="8,6" FontSize="13" 
                                 BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                        <!-- Program Studi -->
                        <TextBlock Text="Program Studi *" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <ComboBox x:Name="cmbProdi" Height="34" Margin="0,4,0,12" FontSize="13" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Teknik Informatika" IsSelected="True"/>
                            <ComboBoxItem Content="Sistem Informasi"/>
                            <ComboBoxItem Content="Sains Data"/>
                            <ComboBoxItem Content="Teknik Komputer"/>
                            <ComboBoxItem Content="Teknologi Informasi"/>
                            <ComboBoxItem Content="Rekayasa Perangkat Lunak"/>
                        </ComboBox>

                        <!-- Jenis Kelamin -->
                        <TextBlock Text="Jenis Kelamin *" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                            <RadioButton x:Name="rbLaki" Content="Laki-laki" IsChecked="True" Margin="0,0,24,0" FontSize="13"/>
                            <RadioButton x:Name="rbPerempuan" Content="Perempuan" FontSize="13"/>
                        </StackPanel>

                        <!-- Tanggal Lahir -->
                        <TextBlock Text="Tanggal Lahir *" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <DatePicker x:Name="dpTanggalLahir" Height="34" Margin="0,4,0,12" FontSize="13" VerticalContentAlignment="Center"/>

                        <!-- Tahun Angkatan -->
                        <TextBlock Text="Tahun Angkatan *" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <ComboBox x:Name="cmbAngkatan" Height="34" Margin="0,4,0,12" FontSize="13" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="2026" IsSelected="True"/>
                            <ComboBoxItem Content="2025"/>
                            <ComboBoxItem Content="2024"/>
                            <ComboBoxItem Content="2023"/>
                            <ComboBoxItem Content="2022"/>
                        </ComboBox>

                        <!-- Jalur Masuk -->
                        <TextBlock Text="Jalur Masuk *" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <ComboBox x:Name="cmbJalur" Height="34" Margin="0,4,0,12" FontSize="13" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="SNBP (Prestasi)" IsSelected="True"/>
                            <ComboBoxItem Content="SNBT (Tes Tertulis)"/>
                            <ComboBoxItem Content="Seleksi Mandiri Kemitraan"/>
                            <ComboBoxItem Content="Seleksi Mandiri Prestasi"/>
                            <ComboBoxItem Content="International Undergraduate Program (IUP)"/>
                        </ComboBox>

                        <!-- Email -->
                        <TextBlock Text="Alamat Email *" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="txtEmail" Height="34" Margin="0,4,0,20" Padding="8,6" FontSize="13" 
                                 BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                        <!-- Action Buttons -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnSimpan" Grid.Column="0" Content="💾 Simpan Data" Height="38"
                                    Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13"
                                    BorderThickness="0" Cursor="Hand" Click="BtnSimpan_Click"/>
                            <Button x:Name="btnReset" Grid.Column="2" Content="🔄 Reset Form" Height="38"
                                    Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" FontSize="13"
                                    BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnReset_Click"/>
                        </Grid>

                        <Button x:Name="btnHapus" Content="🗑️ Hapus Mahasiswa Terpilih" Height="36"
                                Background="#FEE2E2" Foreground="#DC2626" FontWeight="SemiBold" FontSize="12"
                                BorderBrush="#FCA5A5" BorderThickness="1" Cursor="Hand" Click="BtnHapus_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel: Data Presentation -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#CBD5E1" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter & Title Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Data Mahasiswa Terdaftar" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Pilih salah satu baris untuk melihat detail atau menghapus data." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Search Box -->
                        <TextBox x:Name="txtSearch" Grid.Column="1" Height="34" Padding="10,6" FontSize="12"
                                 BorderBrush="#CBD5E1" VerticalContentAlignment="Center"
                                 TextChanged="TxtSearch_TextChanged"/>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid x:Name="dgMahasiswa" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              RowHeight="36"
                              FontSize="12"
                              BorderThickness="1"
                              BorderBrush="#E2E8F0"
                              Background="White"
                              SelectionChanged="DgMahasiswa_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NRP" Binding="{Binding NRP}" Width="105" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding Nama}" Width="160"/>
                            <DataGridTextColumn Header="Program Studi" Binding="{Binding Prodi}" Width="145"/>
                            <DataGridTextColumn Header="Gender" Binding="{Binding JenisKelamin}" Width="85"/>
                            <DataGridTextColumn Header="Tgl Lahir" Binding="{Binding TanggalLahirFormat}" Width="90"/>
                            <DataGridTextColumn Header="Angkatan" Binding="{Binding Angkatan}" Width="75"/>
                            <DataGridTextColumn Header="Jalur Masuk" Binding="{Binding JalurMasuk}" Width="135"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="lblStatus" Text="Siap menerima pendaftaran data mahasiswa." FontSize="12" Foreground="#475569"/>
                <TextBlock Grid.Column="1" Text=".NET 10 WPF Application" FontSize="12" Foreground="#94A3B8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
