<Window x:Class="StudentRegistration.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StudentRegistration.ViewModels"
        Title="Student Registration System (SRS) - SQL Server &amp; ADO.NET (PBKK Pertemuan 6)" 
        Height="800" Width="1300"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- KPI Metric Card Style -->
        <Style x:Key="MetricCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Top Header Bar -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: Metric KPI Cards -->
            <RowDefinition Height="*"/>     <!-- Row 2: Main Workspace (Grid + Form) -->
            <RowDefinition Height="Auto"/>  <!-- Row 3: Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- ROW 0: TOP HEADER BAR                                     -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E3A8A" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                        <TextBlock Text="🗄️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Student Registration System (SRS)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Integrasi Desktop WPF dengan Basis Data Relasional SQL Server menggunakan ADO.NET murni" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions & Connection Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status Badge -->
                    <Border Background="{Binding ConnectionBadgeBackground}" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                        <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="SemiBold" FontSize="12" Foreground="{Binding ConnectionBadgeForeground}"/>
                    </Border>

                    <!-- Tombol Uji Koneksi -->
                    <Button Content="🔌 Uji Koneksi" Command="{Binding TestConnectionCommand}"
                            Height="32" Padding="10,0" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155"
                            BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>

                    <!-- Tombol Refresh -->
                    <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}"
                            Height="32" Padding="10,0" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155"
                            BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>

                    <!-- Tombol Inisialisasi DB -->
                    <Button Content="⚙️ Inisialisasi DB" Command="{Binding ProvisionDatabaseCommand}"
                            Height="32" Padding="12,0" Background="#EFF6FF" Foreground="#1D4ED8"
                            BorderBrush="#BFDBFE" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                            ToolTip="Inisialisasi otomatis tabel dan data awal di SQL Server"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- ROW 1: 4 METRIC KPI CARDS                                 -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1" Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Mahasiswa -->
            <Border Grid.Column="0" Style="{StaticResource MetricCardBorderStyle}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="TOTAL MAHASISWA" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalStudents}" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,4,0,0"/>
                        <TextBlock Text="Tersimpan di SQL Server" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Text="👥" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Card 2: Rata-Rata IPK -->
            <Border Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="RATA-RATA IPK (GPA)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding AverageGPA}" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                        <TextBlock Text="Skala nilai 4.00" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Text="⭐" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Card 3: Mahasiswa Aktif -->
            <Border Grid.Column="4" Style="{StaticResource MetricCardBorderStyle}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="MAHASISWA AKTIF" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ActiveStudents}" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                        <TextBlock Text="Status aktif perkuliahan" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Text="🟢" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Card 4: Cumlaude -->
            <Border Grid.Column="6" Style="{StaticResource MetricCardBorderStyle}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="PREDIKAT CUMLAUDE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding CumlaudeStudents}" FontSize="24" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                        <TextBlock Text="IPK ≥ 3.51 (Dengan Pujian)" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Text="🏆" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- ROW 2: MAIN WORKSPACE (TABLE & FORM)                      -->
        <!-- ========================================================= -->
        <Grid Grid.Row="2" Margin="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Search, Filters, DataGrid -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Filter & Search Bar -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box with Placeholder -->
                        <Grid Grid.Column="0">
                            <TextBox x:Name="txtSearch" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" Padding="24,4,8,4" FontSize="12" VerticalContentAlignment="Center"
                                     ToolTip="Cari berdasarkan NIM, Nama, atau Email"/>
                            <TextBlock Text="🔍" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       IsHitTestVisible="False" Foreground="#94A3B8"/>
                            <TextBlock Text="Cari NIM, Nama, Email..." FontSize="12" Margin="26,0,0,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="#94A3B8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Filter Program Studi -->
                        <ComboBox Grid.Column="2" ItemsSource="{Binding FilterPrograms}"
                                  SelectedItem="{Binding SelectedFilterProgram}"
                                  DisplayMemberPath="ProgramName"
                                  Height="32" FontSize="12" VerticalContentAlignment="Center"/>

                        <!-- Filter Status -->
                        <ComboBox Grid.Column="4" ItemsSource="{Binding FilterStatusList}"
                                  SelectedItem="{Binding SelectedFilterStatus}"
                                  Height="32" FontSize="12" VerticalContentAlignment="Center"/>

                        <!-- Reset Filter -->
                        <Button Grid.Column="6" Content="Reset" Command="{Binding ResetFilterCommand}"
                                Height="32" Padding="12,0" Background="#F1F5F9" Foreground="#475569"
                                BorderBrush="#CBD5E1" BorderThickness="1" FontSize="12" Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- DataGrid Mahasiswa -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              RowHeight="36"
                              FontSize="12"
                              BorderThickness="0"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding StudentId}" Width="45" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="NIM / NRP" Binding="{Binding NIM}" Width="105" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding Name}" Width="165"/>
                            <DataGridTextColumn Header="Program Studi" Binding="{Binding ProgramName}" Width="145"/>
                            <DataGridTextColumn Header="IPK" Binding="{Binding GPAFormat}" Width="55" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Predikat" Binding="{Binding Predikat}" Width="130"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="75"/>
                            <DataGridTextColumn Header="Tgl Lahir" Binding="{Binding BirthDateFormat}" Width="85"/>
                            <DataGridTextColumn Header="Telepon" Binding="{Binding PhoneNumber}" Width="105"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="170"/>
                            <DataGridTextColumn Header="Alamat" Binding="{Binding Address}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Action Bar for Selected Row -->
                <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Aksi Baris Terpilih:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                            <Button Content="✏️ Edit Data" Command="{Binding EditCommand}"
                                    Height="28" Padding="10,0" Margin="0,0,8,0" Background="#EFF6FF"
                                    Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1"
                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                            <Button Content="🗑️ Hapus" Command="{Binding DeleteCommand}"
                                    Height="28" Padding="10,0" Background="#FEF2F2"
                                    Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"
                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Klik baris pada tabel untuk memilih data" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Column: Form Registrasi Mahasiswa (ADO.NET) -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormHeaderTitle}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                        <!-- NIM -->
                        <TextBlock Text="NIM / NRP (Unique Key) *" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox Text="{Binding FormNIM, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsNIMReadOnly}" Height="30" Margin="0,3,0,10"
                                 Padding="6,4" FontSize="12" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                        <!-- Nama Lengkap -->
                        <TextBlock Text="Nama Lengkap *" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" Margin="0,3,0,10" Padding="6,4" FontSize="12"
                                 BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                        <!-- Program Studi (Foreign Key) -->
                        <TextBlock Text="Program Studi (Foreign Key) *" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                        <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedFormProgram}"
                                  DisplayMemberPath="DisplayName"
                                  Height="30" Margin="0,3,0,10" FontSize="12" VerticalContentAlignment="Center"/>

                        <!-- Tanggal Lahir & IPK/GPA -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tanggal Lahir" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <DatePicker SelectedDate="{Binding FormBirthDate}" Height="30" Margin="0,3,0,0" FontSize="12" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="IPK / GPA (0-4) *" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox Text="{Binding FormGPA, UpdateSourceTrigger=PropertyChanged}"
                                         Height="30" Margin="0,3,0,0" Padding="6,4" FontSize="12"
                                         BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Nomor Telepon -->
                        <TextBlock Text="Nomor Telepon / WA" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox Text="{Binding FormPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" Margin="0,3,0,10" Padding="6,4" FontSize="12"
                                 BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                        <!-- Email -->
                        <TextBlock Text="Alamat Email" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" Margin="0,3,0,10" Padding="6,4" FontSize="12"
                                 BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>

                        <!-- Alamat -->
                        <TextBlock Text="Alamat Domisili" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Height="50" Margin="0,3,0,10" Padding="6,4" FontSize="12"
                                 TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#CBD5E1"/>

                        <!-- Status Aktif CheckBox -->
                        <CheckBox IsChecked="{Binding FormIsActive}" Content="Mahasiswa Aktif Perkuliahan"
                                  FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,16"/>

                        <!-- Action Buttons -->
                        <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}"
                                Height="36" Background="#2563EB" Foreground="White" FontWeight="Bold"
                                FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,0,6"/>

                        <Button Content="🔄 Kosongkan / Batal" Command="{Binding NewCommand}"
                                Height="32" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold"
                                FontSize="12" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- ROW 3: BOTTOM STATUS BAR                                  -->
        <!-- ========================================================= -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#475569"/>
                <TextBlock Grid.Column="1" Text="{Binding DatabaseInfo}" FontSize="12" Foreground="#94A3B8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
